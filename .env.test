# Test Environment Configuration
# This file is used when running tests

# GitHub OAuth Application Credentials (not needed for tests)
GITHUB_CLIENT_ID=test_client_id
GITHUB_CLIENT_SECRET=test_client_secret

# GitHub Repository Configuration
GITHUB_OWNER=test_owner
GITHUB_REPO=test_repo

# Session Encryption
SESSION_SECRET=test_session_secret_key_for_testing_only

# Application URL
PUBLIC_APP_URL=http://localhost:5173

# Micropub Storage Backend - use in-memory test backend for tests
MICROPUB_BACKEND=test
