# Build-time placeholder values for SvelteKit
# These tell SvelteKit which env vars exist - actual values loaded at runtime
#
# For local development: Create .env.local with your real values (gitignored)
# For production: Set real values in Cloudflare Pages dashboard
#
# This file is safe to commit - contains no secrets

GITHUB_CLIENT_ID=placeholder
GITHUB_CLIENT_SECRET=placeholder
GITHUB_OWNER=placeholder
GITHUB_REPO=placeholder
SESSION_SECRET=placeholder_at_least_32_characters_long
PUBLIC_APP_URL=http://localhost:5173
