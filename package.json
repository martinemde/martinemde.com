{
  "name": "martinemde.github.io",
  "version": "0.0.1",
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@neoconfetti/svelte": "^2.2.2",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@typescript/native": "npm:typescript@7",
    "@vitest/ui": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "jsdom": "^30.1.2",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "0.35.5",
    "shiki": "^4.5.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.148.0",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "lucide-svelte": "^1.0.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "unified": "^11.0.5"
  },
  "private": true,
  "scripts": {
    "dev": "bun run social:images && bun run images:optimize && vite dev",
    "build": "bun run social:images && bun run images:optimize && svelte-kit sync && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "format": "prettier --log-level silent --list-different --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run && bun run test:publishing",
    "test:publishing": "bun test scripts/blog-publishing.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "blog:new": "bun scripts/blog-new.ts",
    "blog:publish": "bun scripts/blog-publish.ts",
    "social:images": "bun scripts/social-images.ts",
    "images:optimize": "bun scripts/optimize-images.ts"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
