# GitHub OAuth Application Credentials
# Create an OAuth app at https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# GitHub Repository Configuration
# The owner and repository name where blog posts will be committed
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repository_name

# Session Encryption
# Generate a strong random string for encrypting session cookies
# Example: openssl rand -base64 32
SESSION_SECRET=your_random_32_char_or_longer_secret_key

# Application URL (used for OAuth callback)
# Development: http://localhost:5173
# Production: https://yourdomain.com
PUBLIC_APP_URL=http://localhost:5173
