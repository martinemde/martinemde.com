    "@neoconfetti/svelte": "^2.2.2",
    "@skeletonlabs/skeleton": "5.0.1",
    "@skeletonlabs/skeleton-svelte": "^5.0.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@typescript/native": "npm:typescript@7",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "jsdom": "^30.0.1",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shiki": "^4.3.0",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "lucide-svelte": "^1.0.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "unified": "^11.0.5"
  },
  "private": true,
  "scripts": {
    "dev": "vite dev",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --tsgo --watch",
    "format": "prettier --log-level silent --list-different --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "blog:new": "bun scripts/blog-new.ts",
    "blog:publish": "bun scripts/blog-publish.ts"
  },
  "type": "module"
}
